# Variables pour le déploiement Docker sur le VPS (docker-compose.yml)
# Copier vers `.env` sur le serveur (jamais commit) : cp .env.production.example .env

POSTGRES_PASSWORD="choisissez-un-mot-de-passe-fort"
AUTH_SECRET="generez-avec: openssl rand -base64 32"
BLOB_READ_WRITE_TOKEN="jeton depuis Vercel Storage > Blob (voir README)"
DOMAIN="egbm.ci"

# Utilisé une seule fois, manuellement, pour créer le compte Administrateur en prod :
# docker compose exec -e SEED_ADMIN_EMAIL=... -e SEED_ADMIN_PASSWORD=... app npx prisma db seed
