// Schéma EGBM — voir doc/extracted/cahier-des-charges-egbm.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
}

enum PublicationType {
  PUBLICATION
  EVENEMENT
}

// NOUVELLE = en attente de confirmation, EN_COURS = en préparation, LIVREE = terminée.
enum OrderStatus {
  NOUVELLE
  EN_COURS
  LIVREE
  CONFIRMEE
  EN_LIVRAISON
  ANNULEE
}

enum OrderSource {
  SITE
  MANUELLE
  DEVIS
}

enum SupplierOrderStatus {
  BROUILLON
  ENVOYEE
  CONFIRMEE
  EXPEDIEE
  RECUE_PARTIELLEMENT
  RECUE
  ANNULEE
}

enum DeliveryStatus {
  PREVUE
  EN_COURS
  EFFECTUEE
  ANNULEE
}

enum StockMovementType {
  LIVRAISON
  RECEPTION
  ANNULATION_LIVRAISON
  REGULARISATION
}

enum OrderEventType {
  ENVOYEE
  LIVRAISON_PARTIELLE
  RECEPTION_PARTIELLE
  RECEPTION
  CREEE
  CONFIRMEE
  PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
  REACTIVEE
  DATE_MODIFIEE
  RESPONSABLE_MODIFIE
}

enum DocumentType {
  FACTURE
  PROFORMA
  DEVIS
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role
  notifyByEmail Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resetTokens       PasswordResetToken[]
  responsibleOrders Order[]
  supplierOrders    SupplierOrder[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders      Order[]
  resetTokens CustomerResetToken[]
  reviews     Review[]
}

model CustomerResetToken {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

// Secteur d'activité (BTP, Agro-chimie…) : géré depuis l'espace entreprise.
model Sector {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  photoUrl    String?
  icon        String   @default("Package")
  position    Int      @default(0)
  active      Boolean  @default(true)
  // Adresse personnalisée : si renseignée, la carte du secteur ouvre ce lien (ex. /catalogues)
  // au lieu du filtre produits, et le secteur ne reçoit pas de produits.
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products     Product[]
  realisations Realisation[]
}

// Catalogue au format PDF, ajouté depuis l'espace entreprise (fichier stocké sur Vercel Blob).
model Catalogue {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int
  coverUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  sectorId    String
  price       Int
  stock       Int      @default(0)
  sold        Int      @default(0)
  description String?
  // Unité de vente facultative (sac, tonne, barre…), affichée à côté de la quantité.
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media          ProductMedia[]
  orderItems     OrderItem[]
  supplierItems  SupplierOrderItem[]
  stockMovements StockMovement[]
  documentLines  DocumentLine[]
  reviews        Review[]
}

model ProductMedia {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  type      MediaType
  order     Int       @default(0)
  createdAt DateTime  @default(now())
}

model Publication {
  id        String          @id @default(cuid())
  type      PublicationType
  title     String
  text      String
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
}

model Order {
  id            String      @id @default(cuid())
  clientName    String
  clientPhone   String
  clientAddress String?
  // Facultatifs, saisis dans la demande de devis du panier (visibles dans l'e-mail de notification).
  clientCompany String?
  message       String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  total         Int
  status        OrderStatus @default(NOUVELLE)
  // Suivi des commandes : référence lisible, origine, date prévue et employé responsable.
  reference     String?     @unique
  source        OrderSource @default(SITE)
  expectedDate  DateTime?
  confirmedAt   DateTime?
  responsible   User?       @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  responsibleId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         OrderItem[]
  events        OrderEvent[]
  deliveries    Delivery[]
  quoteRequests QuoteRequest[]
}

// Livraison (totale ou partielle) d'une commande client : seules les livraisons « effectuées » font bouger le stock.
model Delivery {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  plannedDate DateTime?
  status      DeliveryStatus @default(PREVUE)
  deliveredAt DateTime?
  note        String?
  authorId    String?
  authorName  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines DeliveryLine[]

  @@index([orderId])
  @@index([status, plannedDate])
}

model DeliveryLine {
  id          String    @id @default(cuid())
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId  String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String
  quantity    Int

  movements StockMovement[]
}

// Commande d'approvisionnement auprès d'un fournisseur (nom saisi librement).
model SupplierOrder {
  id              String              @id @default(cuid())
  reference       String              @unique
  supplierName    String
  supplierContact String?
  status          SupplierOrderStatus @default(BROUILLON)
  expectedDate    DateTime?
  notes           String?
  responsible     User?               @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  responsibleId   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items    SupplierOrderItem[]
  events   OrderEvent[]
  receipts SupplierReceipt[]
}

model SupplierOrderItem {
  id              String        @id @default(cuid())
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierOrderId String
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  productName     String
  quantity        Int
  receivedQty     Int           @default(0)

  receiptLines SupplierReceiptLine[]
}

// Réception (totale ou partielle) de marchandises : chaque ligne fait entrer du stock une seule fois.
model SupplierReceipt {
  id              String        @id @default(cuid())
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierOrderId String
  note            String?
  authorId        String?
  authorName      String
  receivedAt      DateTime      @default(now())

  lines SupplierReceiptLine[]
}

model SupplierReceiptLine {
  id        String            @id @default(cuid())
  receipt   SupplierReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId String
  item      SupplierOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  quantity  Int

  movements StockMovement[]
}

// Historique de stock d'un produit. Les contraintes d'unicité empêchent de compter deux fois la même ligne.
model StockMovement {
  id             String               @id @default(cuid())
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  type           StockMovementType
  quantity       Int
  deliveryLine   DeliveryLine?        @relation(fields: [deliveryLineId], references: [id], onDelete: SetNull)
  deliveryLineId String?
  receiptLine    SupplierReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)
  receiptLineId  String?
  reference      String?
  note           String?
  authorId       String?
  authorName     String
  createdAt      DateTime             @default(now())

  @@unique([deliveryLineId, type])
  @@unique([receiptLineId, type])
  @@index([productId, createdAt])
}

// Chronologie et historique d'une commande : un enregistrement par événement réel.
model OrderEvent {
  id              String         @id @default(cuid())
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String?
  supplierOrder   SupplierOrder? @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierOrderId String?
  type            OrderEventType
  fromStatus      OrderStatus?
  toStatus        OrderStatus?
  oldDate         DateTime?
  newDate         DateTime?
  note            String?
  // Description système de l'événement (ex. « Livraison de 2 lignes »), distincte de l'observation du personnel.
  detail          String?
  authorId        String?
  authorName      String
  createdAt       DateTime       @default(now())

  @@index([supplierOrderId, createdAt])
  @@index([orderId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int

  deliveryLines DeliveryLine[]
}

// Compteur transactionnel pour la numérotation des documents (ex: id = "FACTURE-2026")
model DocumentCounter {
  id     String @id
  lastNo Int    @default(0)
}

model Document {
  id            String       @id @default(cuid())
  number        String       @unique
  type          DocumentType
  clientName    String
  clientContact String?
  clientAddress String?
  objet         String?
  vatApplicable Boolean      @default(true)
  validityDays  Int?
  subtotal      Int
  vat           Int
  total         Int
  createdAt     DateTime     @default(now())

  lines DocumentLine[]
}

model DocumentLine {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  productName     String
  quantity        Int
  unitPriceGross  Int
  discountPercent Int      @default(0)
  unitPrice       Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  message   String
  createdAt DateTime @default(now())
}

model Realisation {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  sector      Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  sectorId    String?
  photoUrl    String?
  createdAt   DateTime @default(now())
}

model QuoteRequest {
  id               String   @id @default(cuid())
  clientName       String
  clientPhone      String
  clientEmail      String?
  clientCompany    String?
  message          String
  // Renseigné quand la demande a été convertie explicitement en commande.
  convertedOrder   Order?   @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  convertedOrderId String?
  createdAt        DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  rating     Int
  comment    String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, customerId])
}
