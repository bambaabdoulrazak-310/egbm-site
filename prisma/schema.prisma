// Schéma EGBM — voir doc/extracted/cahier-des-charges-egbm.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
}

enum PublicationType {
  PUBLICATION
  EVENEMENT
}

enum OrderStatus {
  NOUVELLE
  EN_COURS
  LIVREE
}

enum DocumentType {
  FACTURE
  PROFORMA
  DEVIS
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  notifyByEmail Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders      Order[]
  resetTokens CustomerResetToken[]
  reviews     Review[]
}

model CustomerResetToken {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

// Secteur d'activité (BTP, Agro-chimie…) : géré depuis l'espace entreprise.
model Sector {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  photoUrl    String?
  icon        String   @default("Package")
  position    Int      @default(0)
  active      Boolean  @default(true)
  // Adresse personnalisée : si renseignée, la carte du secteur ouvre ce lien (ex. /catalogues)
  // au lieu du filtre produits, et le secteur ne reçoit pas de produits.
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products     Product[]
  realisations Realisation[]
}

// Catalogue au format PDF, ajouté depuis l'espace entreprise (fichier stocké sur Vercel Blob).
model Catalogue {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int
  coverUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  sectorId    String
  price       Int
  stock       Int      @default(0)
  sold        Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media         ProductMedia[]
  orderItems    OrderItem[]
  documentLines DocumentLine[]
  reviews       Review[]
}

model ProductMedia {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  type      MediaType
  order     Int       @default(0)
  createdAt DateTime  @default(now())
}

model Publication {
  id        String          @id @default(cuid())
  type      PublicationType
  title     String
  text      String
  date      DateTime        @default(now())
  createdAt DateTime        @default(now())
}

model Order {
  id            String      @id @default(cuid())
  clientName    String
  clientPhone   String
  clientAddress String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  total         Int
  status        OrderStatus @default(NOUVELLE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productName String
  quantity    Int
  unitPrice   Int
}

// Compteur transactionnel pour la numérotation des documents (ex: id = "FACTURE-2026")
model DocumentCounter {
  id     String @id
  lastNo Int    @default(0)
}

model Document {
  id             String       @id @default(cuid())
  number         String       @unique
  type           DocumentType
  clientName     String
  clientContact  String?
  clientAddress  String?
  objet          String?
  vatApplicable  Boolean      @default(true)
  validityDays   Int?
  subtotal       Int
  vat            Int
  total          Int
  createdAt      DateTime     @default(now())

  lines DocumentLine[]
}

model DocumentLine {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  productName     String
  quantity        Int
  unitPriceGross  Int
  discountPercent Int      @default(0)
  unitPrice       Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  message   String
  createdAt DateTime @default(now())
}

model Realisation {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  sector      Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  sectorId    String?
  photoUrl    String?
  createdAt   DateTime @default(now())
}

model QuoteRequest {
  id          String   @id @default(cuid())
  clientName  String
  clientPhone String
  clientEmail String?
  message     String
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  rating     Int
  comment    String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, customerId])
}
