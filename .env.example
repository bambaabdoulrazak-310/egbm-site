# Connexion PostgreSQL (Neon en dev, VPS en prod)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret utilisé pour signer les sessions (générer avec: openssl rand -base64 32)
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-longue"

# Compte Administrateur initial (utilisé uniquement par `npx prisma db seed`)
SEED_ADMIN_NAME="Administrateur EGBM"
SEED_ADMIN_EMAIL="admin@egbm.ci"
SEED_ADMIN_PASSWORD="changez-moi"
